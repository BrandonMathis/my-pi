{
	"name": "pi-working-phrase",
	"version": "0.1.0",
	"description": "A tiny Pi extension that replaces Pi's working status with shuffled phrases, a colored spinner, and an animated shine gradient.",
	"type": "module",
	"license": "MIT",
	"author": "Brandon Mathis",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brandonmathis/pi-working-phrase.git"
	},
	"bugs": {
		"url": "https://github.com/brandonmathis/pi-working-phrase/issues"
	},
	"homepage": "https://github.com/brandonmathis/pi-working-phrase#readme",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"working-status",
		"tui"
	],
	"engines": {
		"node": ">=20.6.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"docs/"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"smoke:load": "node scripts/smoke-load.mjs",
		"pack:check": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@mariozechner/jiti": "^2.6.2",
		"@mariozechner/pi-coding-agent": "^0.72.1",
		"@types/node": "^24.3.0",
		"prettier": "^3.5.3",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	}
}
