# Ignore everything by default
/*

# Keep repository ignore rules tracked
!.gitignore
!/AGENTS.md

# Keep shared Pi configuration, extensions, and the project model-update skill tracked
!/.pi/
.pi/*
!.pi/skills/
.pi/skills/*
!.pi/skills/update-models/
!.pi/skills/update-models/**
!agent/
agent/*
!agent/settings.json
!agent/keybindings.json
!agent/model-preferences/
!agent/model-preferences/**
!agent/extensions/
!agent/extensions/**

# Standalone local extension repos/backups
agent/extensions/pi-working-phrase/
agent/extensions/pi-working-phrase.backup-*/
