# Ignore everything by default
/*

# Keep repository ignore rules tracked
!.gitignore
!/AGENTS.md

# Keep only agent extensions tracked
!agent/
agent/*
!agent/keybindings.json
!agent/extensions/
!agent/extensions/**

# Standalone local extension repos/backups
agent/extensions/pi-working-phrase/
agent/extensions/pi-working-phrase.backup-*/
